<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kiln.Studio.ViewModels"
             x:Class="Kiln.Studio.Views.MenuEditorView"
             x:DataType="vm:MenuEditorViewModel">

    <Grid RowDefinitions="Auto,*"
          Margin="12">

        <!-- Top toolbar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Menus}"
                      SelectedItem="{Binding SelectedMenu}"
                      DisplayMemberBinding="{Binding Name}"
                      MinWidth="160"
                      VerticalAlignment="Center" />
            <Button Content="Rename"
                    Command="{Binding RenameMenuCommand}"
                    Classes="secondary" />
            <Button Content="Delete"
                    Command="{Binding DeleteMenuCommand}"
                    Classes="secondary" />
            <Button Content="+ New Menu"
                    Command="{Binding AddMenuCommand}"
                    Classes="secondary" />
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Classes="primary" />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              IsVisible="{Binding HasSelectedMenu}">

            <!-- Tree + item actions -->
            <Grid Grid.Column="0"
                  RowDefinitions="*,Auto"
                  Margin="0,0,12,0">
                <TreeView x:Name="MenuTree"
                          Grid.Row="0"
                          ItemsSource="{Binding SelectedMenu.Items}"
                          SelectedItem="{Binding SelectedItem}"
                          DragDrop.AllowDrop="True">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="DragDrop.AllowDrop" Value="True" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}"
                                          DataType="vm:MenuItemViewModel">
                            <TextBlock Text="{Binding Title}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,8,0,0">
                    <Button Content="+ Add Item"
                            Command="{Binding AddItemCommand}"
                            Classes="secondary" />
                    <Button Content="▲"
                            Command="{Binding MoveUpCommand}"
                            Classes="quiet" />
                    <Button Content="▼"
                            Command="{Binding MoveDownCommand}"
                            Classes="quiet" />
                    <Button Content="→"
                            Command="{Binding IndentCommand}"
                            Classes="quiet" />
                    <Button Content="←"
                            Command="{Binding OutdentCommand}"
                            Classes="quiet" />
                    <Button Content="Delete"
                            Command="{Binding DeleteItemCommand}"
                            Classes="secondary" />
                </StackPanel>
            </Grid>

            <!-- Detail panel -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
                  IsVisible="{Binding HasSelectedItem}"
                  Margin="12,0,0,0">
                <TextBlock Grid.Row="0"
                           Text="Menu item"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource FontSizeL}"
                           Margin="0,0,0,12" />

                <StackPanel Grid.Row="1"
                            Orientation="Vertical"
                            Spacing="4"
                            Margin="0,0,0,12">
                    <TextBlock Text="Title" />
                    <TextBox Text="{Binding SelectedItem.Title}" />
                    <TextBlock Text="{Binding SelectedItem.Error}"
                               IsVisible="{Binding SelectedItem.HasError}" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Vertical"
                            Spacing="4"
                            Margin="0,0,0,12">
                    <TextBlock Text="Link type" />
                    <ComboBox SelectedItem="{Binding SelectedItem.LinkType}"
                              ItemsSource="{Binding LinkTypes}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Orientation="Vertical"
                            Spacing="4"
                            Margin="0,0,0,12"
                            IsVisible="{Binding SelectedItemIsRef}">
                    <TextBlock Text="Ref" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding RefSuggestions}"
                              Text="{Binding SelectedItem.Ref}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Orientation="Vertical"
                            Spacing="4"
                            Margin="0,0,0,12"
                            IsVisible="{Binding SelectedItemIsUrl}">
                    <TextBlock Text="URL" />
                    <TextBox Text="{Binding SelectedItem.Url}" />
                </StackPanel>

                <CheckBox Grid.Row="5"
                          Content="External"
                          IsChecked="{Binding SelectedItem.External}"
                          Margin="0,0,0,12" />
            </Grid>

            <TextBlock Grid.Column="1"
                       Text="Select an item to edit its details."
                       Classes="muted"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding !HasSelectedItem}" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="Create a menu to get started."
                   Classes="muted"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   IsVisible="{Binding !HasSelectedMenu}" />

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Classes="status-text"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   IsVisible="{Binding HasStatusMessage}" />
    </Grid>
</UserControl>
